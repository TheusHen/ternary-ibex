CAPI=2:
# Copyright lowRISC contributors.
# Licensed under the Apache License, Version 2.0, see LICENSE for details.
# SPDX-License-Identifier: Apache-2.0
name: "lowrisc:ibex:ibex_top_tracing:0.1"
description: "Top level with tracing for Ibex CPU core"

filesets:
  files_rtl:
    depend:
      - lowrisc:ibex:ibex_top
      - lowrisc:ibex:ibex_tracer
    files:
      - rtl/ibex_top_tracing.sv
    file_type: systemVerilogSource

  files_lint_verible:
    files:
      - lint/verilator_waiver.vlt: {file_type: vlt}
      - lint/verible_waiver.vbw: {file_type: veribleLintWaiver}

parameters:
  RVFI:
    datatype: bool
    paramtype: vlogdefine

targets:
  default:
    filesets:
      - tool_veriblelint ? (files_lint_verible)
      - files_rtl
    toplevel: ibex_top_tracing

  lint:
    <<: *default
    default_tool: verilator
    tools:
      verilator:
        mode: lint-only
        verilator_options:
          - "-Wall"