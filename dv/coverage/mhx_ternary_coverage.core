name: lowrisc:ibex:mhx_ternary_coverage:0.1
description: MHX Ternary Extension Coverage Analysis

filesets:
  files_rtl:
    depend:
      - lowrisc:prim:assert
      - lowrisc:ibex:ibex_pkg
    files:
      - rtl/ibex_ternary_regfile.sv
      - rtl/ibex_ternary_alu.sv
      - rtl/ibex_neural_unit.sv
      - dv/coverage/mhx_ternary_coverage_test.sv
    file_type: systemVerilogSource

  files_verilator_cpp:
    files:
      - dv/coverage/mhx_ternary_coverage_main.cpp
    file_type: cppSource

  files_verilator_waiver:
    depend:
      # common waivers
      - lowrisc:lint:common
    files:
      - lint/mhx_ternary_test.vlt
    file_type: vlt

targets:
  default: &default_target
    filesets:
      - tool_verilator ? (files_verilator_waiver)
      - files_rtl
    toplevel: mhx_ternary_coverage_test

  coverage:
    <<: *default_target
    filesets:
      - tool_verilator ? (files_verilator_waiver)
      - files_rtl
      - tool_verilator ? (files_verilator_cpp)
    default_tool: verilator
    tools:
      verilator:
        mode: cc
        verilator_options:
          - '--trace'
          - '--timing'
          - '--coverage'
          - '--coverage-line'
          - '--coverage-toggle'
          - '-CFLAGS "-std=c++17 -g -O0"'
          - '-LDFLAGS "-lgcov"'

  lint:
    <<: *default_target
    default_tool: verilator
    tools:
      verilator:
        mode: lint-only
        verilator_options:
          - "-Wall"