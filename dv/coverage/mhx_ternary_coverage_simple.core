name: lowrisc:ibex:mhx_ternary_coverage_simple:0.1
description: MHX Ternary Extension Simple Coverage Analysis (Verilator compatible)

filesets:
  files_rtl:
    depend:
      - lowrisc:prim:assert
      - lowrisc:ibex:ibex_pkg
    files:
      - ../../rtl/ibex_ternary_regfile.sv
      - ../../rtl/ibex_ternary_alu.sv
      - ../../rtl/ibex_neural_unit.sv
      - mhx_ternary_coverage_simple.sv
    file_type: systemVerilogSource

  files_verilator_cpp:
    files:
      - mhx_ternary_coverage_main.cpp
    file_type: cppSource

  files_verilator_waiver:
    depend:
      - lowrisc:lint:common
    files:
      - ../../lint/mhx_ternary_test.vlt
    file_type: vlt

targets:
  default: &default_target
    filesets:
      - tool_verilator ? (files_verilator_waiver)
      - files_rtl
    toplevel: mhx_ternary_coverage_test

  coverage:
    <<: *default_target
    filesets:
      - tool_verilator ? (files_verilator_waiver)
      - files_rtl
      - tool_verilator ? (files_verilator_cpp)
    default_tool: verilator
    toplevel: mhx_ternary_coverage_test
    tools:
      verilator:
        mode: cc
        verilator_options:
          - --trace
          - --coverage
          - --coverage-line
          - --coverage-toggle
          - --no-timing
          - -Wno-WIDTHEXPAND
          - -Wno-INFINITELOOP
          - -Wno-STMTDLY
          - -CFLAGS "-std=c++17 -g -O0"
          - -LDFLAGS "-lgcov"