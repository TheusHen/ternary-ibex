[tasks]
prove
cover
bmc

[options]
prove: mode prove
prove: depth 30

cover: mode cover
cover: depth 40

bmc: mode bmc
bmc: depth 60

[engines]
prove: smtbmc z3
cover: smtbmc z3
bmc: smtbmc yices

[script]
read -formal -sv ../../rtl/ibex_pkg.sv
read -formal -sv ../../vendor/lowrisc_ip/ip/prim/rtl/prim_assert.sv
read -formal -sv ../../rtl/ibex_ternary_regfile.sv
read -formal -sv ternary_regfile_formal.sv
prep -top ternary_regfile_formal

[files]
../../rtl/ibex_pkg.sv
../../vendor/lowrisc_ip/ip/prim/rtl/prim_assert.sv
../../rtl/ibex_ternary_regfile.sv
ternary_regfile_formal.sv
