name: lowrisc:ibex:mhx_ternary_test:0.1
description: MHX Ternary Extension Testbench

filesets:
  files_rtl:
    depend:
      - lowrisc:prim:assert
      - lowrisc:ibex:ibex_pkg
    files:
      - rtl/ibex_ternary_regfile.sv
      - rtl/ibex_ternary_alu.sv
      - rtl/ibex_neural_unit.sv
      - dv/mhx_ternary_test.sv
    file_type: systemVerilogSource

  files_verilator_waiver:
    depend:
      # common waivers
      - lowrisc:lint:common
    files:
      - lint/mhx_ternary_test.vlt
    file_type: vlt

  files_ascentlint_waiver:
    depend:
      - lowrisc:lint:common
    files:
      - lint/mhx_ternary_test.waiver
    file_type: waiver

  files_veriblelint_waiver:
    depend:
      - lowrisc:lint:common

targets:
  default: &default_target
    filesets:
      - tool_verilator ? (files_verilator_waiver)
      - tool_ascentlint ? (files_ascentlint_waiver)
      - tool_veriblelint ? (files_veriblelint_waiver)
      - files_rtl
    toplevel: mhx_ternary_test

  sim:
    <<: *default_target
    default_tool: verilator
    tools:
      verilator:
        mode: cc
        verilator_options:
          - '--assert'
          - '--trace'
          - '--trace-fst' # this requires -DVM_TRACE_FMT_FST in CPPFLAGS below!
          - '--trace-structs'
          - '--trace-params'
          - '--trace-max-array 1024'
          - '-CFLAGS "-std=c++11 -Wall -DVM_TRACE_FMT_FST -DTOPLEVEL_NAME=mhx_ternary_test"'
          - '-LDFLAGS "-pthread -lutil -lelf"'
          - "--x-assign=fast"
          - "--x-initial=fast"
          - "--noassert"

  lint:
    <<: *default_target
    default_tool: verilator
    tools:
      verilator:
        mode: lint-only
        verilator_options:
          - "--top-module mhx_ternary_test"
          - "-Wall"
      veriblelint:
        rules:
          - "-line-length"
          - "-parameter-name-style"
      ascentlint:
        ascentlint_options:
          - "-wait_for_license"