---
interface Props {
  percentage: number;
  label?: string;
  color?: 'blue' | 'green' | 'yellow' | 'red';
  size?: 'sm' | 'md' | 'lg';
}

const { percentage, label, color = 'blue', size = 'md' } = Astro.props;

const colorClasses = {
  blue: 'from-blue-500 to-indigo-600',
  green: 'from-green-500 to-emerald-600',
  yellow: 'from-yellow-500 to-orange-500',
  red: 'from-red-500 to-rose-600',
};

const sizeClasses = {
  sm: 'h-2',
  md: 'h-3',
  lg: 'h-4',
};

const clampedPercentage = Math.min(100, Math.max(0, percentage));
---

<div class="w-full">
  {label && (
    <div class="flex justify-between items-center mb-2">
      <span class="text-sm font-medium text-gray-700 dark:text-gray-300">{label}</span>
      <span class="text-sm font-semibold text-gray-900 dark:text-white">{clampedPercentage.toFixed(1)}%</span>
    </div>
  )}
  <div class={`w-full bg-gray-200 dark:bg-gray-700 rounded-full overflow-hidden ${sizeClasses[size]}`}>
    <div
      class={`h-full bg-gradient-to-r ${colorClasses[color]} rounded-full transition-all duration-500 ease-out`}
      style={`width: ${clampedPercentage}%`}
    />
  </div>
</div>
