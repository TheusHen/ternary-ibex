---
interface Props {
  title: string;
  value: string | number;
  subtitle?: string;
  icon?: 'check' | 'warning' | 'error' | 'chart' | 'cpu' | 'speed' | 'memory';
  status?: 'success' | 'warning' | 'error' | 'info';
  trend?: 'up' | 'down' | 'stable';
  trendValue?: string;
}

const { title, value, subtitle, icon = 'chart', status = 'info', trend, trendValue } = Astro.props;

const statusColors = {
  success: 'from-green-500 to-emerald-600',
  warning: 'from-yellow-500 to-orange-500',
  error: 'from-red-500 to-rose-600',
  info: 'from-blue-500 to-indigo-600',
};

const iconPaths = {
  check: 'M5 13l4 4L19 7',
  warning: 'M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z',
  error: 'M6 18L18 6M6 6l12 12',
  chart: 'M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z',
  cpu: 'M9 3v2m6-2v2M9 19v2m6-2v2M3 9h2m-2 6h2m14-6h2m-2 6h2M7 19h10a2 2 0 002-2V7a2 2 0 00-2-2H7a2 2 0 00-2 2v10a2 2 0 002 2zM9 9h6v6H9V9z',
  speed: 'M13 10V3L4 14h7v7l9-11h-7z',
  memory: 'M4 7v10c0 2 1 3 3 3h10c2 0 3-1 3-3V7c0-2-1-3-3-3H7C5 4 4 5 4 7zm12 0h2M6 7H4m16 5h-2M6 12H4m16 5h-2M6 17H4M9 7v10m3-10v10m3-10v10',
};

const trendColors = {
  up: 'text-green-600 dark:text-green-400',
  down: 'text-red-600 dark:text-red-400',
  stable: 'text-gray-600 dark:text-gray-400',
};
---

<div class="relative overflow-hidden rounded-2xl bg-white dark:bg-gray-900 border border-gray-200 dark:border-gray-800 shadow-sm hover:shadow-md transition-shadow">
  <!-- Gradient accent -->
  <div class={`absolute top-0 left-0 right-0 h-1 bg-gradient-to-r ${statusColors[status]}`}></div>
  
  <div class="p-6">
    <div class="flex items-start justify-between">
      <div class="flex-1">
        <p class="text-sm font-medium text-gray-500 dark:text-gray-400">{title}</p>
        <p class="mt-2 text-3xl font-bold text-gray-900 dark:text-white">{value}</p>
        {subtitle && (
          <p class="mt-1 text-sm text-gray-600 dark:text-gray-400">{subtitle}</p>
        )}
        {trend && trendValue && (
          <div class={`mt-2 flex items-center gap-1 text-sm ${trendColors[trend]}`}>
            {trend === 'up' && (
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 10l7-7m0 0l7 7m-7-7v18" />
              </svg>
            )}
            {trend === 'down' && (
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
              </svg>
            )}
            <span>{trendValue}</span>
          </div>
        )}
      </div>
      
      <div class={`p-3 rounded-xl bg-gradient-to-br ${statusColors[status]} bg-opacity-10`}>
        <svg class="w-6 h-6 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d={iconPaths[icon]} />
        </svg>
      </div>
    </div>
  </div>
</div>
