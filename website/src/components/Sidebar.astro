---
const baseUrl = import.meta.env.BASE_URL;

const sidebarSections = [
  {
    title: 'Getting Started',
    items: [
      { href: '/docs', label: 'Overview' },
      { href: '/docs/quick-start', label: 'Quick Start' },
    ]
  },
  {
    title: 'Architecture',
    items: [
      { href: '/architecture', label: 'Overview & Floorplan' },
    ]
  },
  {
    title: 'Performance',
    items: [
      { href: '/metrics', label: 'Metrics & Benchmarks' },
    ]
  },
  {
    title: 'Verification',
    items: [
      { href: '/verification', label: 'Tests & Coverage' },
    ]
  },
  {
    title: 'Reference',
    items: [
      { href: '/docs/instruction-set', label: 'Instruction Set' },
      { href: '/docs/integration', label: 'Integration Guide' },
      { href: '/docs/security', label: 'Security Analysis' },
    ]
  }
];

const currentPath = Astro.url.pathname;
---

<aside class="hidden lg:block fixed left-0 top-16 bottom-0 w-64 bg-gray-50 dark:bg-gray-900/50 border-r border-gray-200 dark:border-gray-800 overflow-y-auto">
  <nav class="p-4 space-y-6">
    {sidebarSections.map((section) => (
      <div>
        <h3 class="text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wider mb-2">
          {section.title}
        </h3>
        <ul class="space-y-1">
          {section.items.map((item) => (
            <li>
              <a
                href={`${baseUrl}${item.href}`}
                class:list={[
                  'block px-3 py-2 rounded-lg text-sm transition-colors',
                  currentPath === `${baseUrl}${item.href}`
                    ? 'bg-primary-100 dark:bg-primary-900/50 text-primary-700 dark:text-primary-300 font-medium'
                    : 'text-gray-600 dark:text-gray-400 hover:bg-gray-100 dark:hover:bg-gray-800 hover:text-gray-900 dark:hover:text-white'
                ]}
              >
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </div>
    ))}
    
    <!-- Build Info -->
    <div class="pt-4 border-t border-gray-200 dark:border-gray-800">
      <div class="px-3 py-2 text-xs text-gray-500 dark:text-gray-400">
        <p>Last updated:</p>
        <p class="font-mono" id="last-updated">Loading...</p>
      </div>
    </div>
  </nav>
</aside>

<script>
  // Load build info
  fetch(import.meta.env.BASE_URL + '/data/build-info.json')
    .then(res => res.json())
    .then(data => {
      const el = document.getElementById('last-updated');
      if (el && data.timestamp) {
        el.textContent = new Date(data.timestamp).toLocaleDateString('en-US', {
          year: 'numeric',
          month: 'short',
          day: 'numeric',
          hour: '2-digit',
          minute: '2-digit'
        });
      }
    })
    .catch(() => {
      const el = document.getElementById('last-updated');
      if (el) el.textContent = 'N/A';
    });
</script>
