            <th class="px-4 py-3 text-left text-sm font-semibold text-gray-900 dark:text-white border border-gray-200 dark:border-gray-700">Type</th>
            <th class="px-4 py-3 text-left text-sm font-semibold text-gray-900 dark:text-white border border-gray-200 dark:border-gray-700">Default</th>
            <th class="px-4 py-3 text-left text-sm font-semibold text-gray-900 dark:text-white border border-gray-200 dark:border-gray-700">Description</th>
          </tr>
        </thead>
        <tbody>
          <tr class="bg-white dark:bg-gray-900">
            <td class="px-4 py-3 text-sm font-mono text-gray-900 dark:text-white border border-gray-200 dark:border-gray-700">TernarySupport</td>
            <td class="px-4 py-3 text-sm text-gray-600 dark:text-gray-400 border border-gray-200 dark:border-gray-700">bit</td>
            <td class="px-4 py-3 text-sm font-mono text-gray-600 dark:text-gray-400 border border-gray-200 dark:border-gray-700">1'b1</td>
            <td class="px-4 py-3 text-sm text-gray-600 dark:text-gray-400 border border-gray-200 dark:border-gray-700">Enable ternary ALU and register file</td>
          </tr>
          <tr class="bg-gray-50 dark:bg-gray-800/50">
            <td class="px-4 py-3 text-sm font-mono text-gray-900 dark:text-white border border-gray-200 dark:border-gray-700">NeuralSupport</td>
            <td class="px-4 py-3 text-sm text-gray-600 dark:text-gray-400 border border-gray-200 dark:border-gray-700">bit</td>
            <td class="px-4 py-3 text-sm font-mono text-gray-600 dark:text-gray-400 border border-gray-200 dark:border-gray-700">1'b1</td>
            <td class="px-4 py-3 text-sm text-gray-600 dark:text-gray-400 border border-gray-200 dark:border-gray-700">Enable neural processing unit</td>
          </tr>
