---
import DocsLayout from '../layouts/DocsLayout.astro';
import StatCard from '../components/StatCard.astro';
import ProgressBar from '../components/ProgressBar.astro';

// Load metrics data
const metricsData = await import('../data/metrics.json').catch(() => ({
  default: {
    performance: {
      neural_inference_speedup: 1.5,
      matrix_operation_speedup: 1.6,
      memory_usage_reduction: 93.8,
      power_reduction_estimate: 70.0,
      efficiency_score: 125.5,
    },
    area: {
      ternary_alu_gates: 2500,
      ternary_regfile_gates: 4000,
      neural_unit_gates: 8000,
      total_overhead_gates: 15000,
      percentage_of_base: 40,
    },
    power: {
      estimated_mw: 5.0,
      voltage: 1.8,
      frequency_mhz: 50,
      reduction_percent: 70.0,
    },
    timing: {
      target_frequency_mhz: 50,
      critical_path: 'ternary_multiply',
      setup_slack_ns: 2.0,
      hold_slack_ns: 0.5,
    },
  }
}));

const metrics = metricsData.default;
---

<DocsLayout title="Performance Metrics">
  <div class="prose dark:prose-invert max-w-none">
    <h1>Performance Metrics & Analysis</h1>
    
    <p class="lead text-lg text-gray-600 dark:text-gray-300">
      Comprehensive performance analysis of the MHX Ternary RISC-V Core.
    </p>
    
    <h2>Overview</h2>
    
    <div class="not-prose grid md:grid-cols-2 lg:grid-cols-4 gap-6 my-8">
      <StatCard
        title="Neural Speedup"
        value={`${metrics.performance.neural_inference_speedup}x`}
        subtitle="vs software baseline"
        icon="speed"
        status="success"
        trend="up"
        trendValue="Optimized"
      />
      
      <StatCard
        title="Memory Savings"
        value={`${metrics.performance.memory_usage_reduction}%`}
        subtitle="Ternary encoding"
        icon="memory"
        status="success"
      />
      
      <StatCard
        title="Power Reduction"
        value={`${metrics.power.reduction_percent}%`}
        subtitle="Estimated savings"
        icon="cpu"
        status="success"
      />
      
      <StatCard
        title="Efficiency Score"
        value={metrics.performance.efficiency_score.toFixed(1)}
        subtitle="Combined metric"
        icon="chart"
        status="info"
      />
    </div>
    
    <h2>Performance Benchmarks</h2>
    
    <h3>Computational Performance</h3>
    
    <div class="not-prose overflow-x-auto my-8">
      <table class="min-w-full border-collapse">
        <thead>
          <tr class="bg-gray-100 dark:bg-gray-800">
            <th class="px-4 py-3 text-left text-sm font-semibold text-gray-900 dark:text-white border border-gray-200 dark:border-gray-700">Operation</th>
            <th class="px-4 py-3 text-right text-sm font-semibold text-gray-900 dark:text-white border border-gray-200 dark:border-gray-700">Software</th>
            <th class="px-4 py-3 text-right text-sm font-semibold text-gray-900 dark:text-white border border-gray-200 dark:border-gray-700">Hardware</th>
            <th class="px-4 py-3 text-right text-sm font-semibold text-gray-900 dark:text-white border border-gray-200 dark:border-gray-700">Speedup</th>
          </tr>
        </thead>
        <tbody>
          <tr class="bg-white dark:bg-gray-900">
            <td class="px-4 py-3 text-sm text-gray-900 dark:text-white border border-gray-200 dark:border-gray-700">16-trit Addition</td>
            <td class="px-4 py-3 text-sm text-right font-mono text-gray-600 dark:text-gray-400 border border-gray-200 dark:border-gray-700">48 cycles</td>
            <td class="px-4 py-3 text-sm text-right font-mono text-gray-600 dark:text-gray-400 border border-gray-200 dark:border-gray-700">1 cycle</td>
            <td class="px-4 py-3 text-sm text-right font-bold text-green-600 dark:text-green-400 border border-gray-200 dark:border-gray-700">48.0x</td>
          </tr>
          <tr class="bg-gray-50 dark:bg-gray-800/50">
            <td class="px-4 py-3 text-sm text-gray-900 dark:text-white border border-gray-200 dark:border-gray-700">16-trit Multiplication</td>
            <td class="px-4 py-3 text-sm text-right font-mono text-gray-600 dark:text-gray-400 border border-gray-200 dark:border-gray-700">156 cycles</td>
            <td class="px-4 py-3 text-sm text-right font-mono text-gray-600 dark:text-gray-400 border border-gray-200 dark:border-gray-700">3 cycles</td>
            <td class="px-4 py-3 text-sm text-right font-bold text-green-600 dark:text-green-400 border border-gray-200 dark:border-gray-700">52.0x</td>
          </tr>
          <tr class="bg-white dark:bg-gray-900">
            <td class="px-4 py-3 text-sm text-gray-900 dark:text-white border border-gray-200 dark:border-gray-700">Neural MAC</td>
            <td class="px-4 py-3 text-sm text-right font-mono text-gray-600 dark:text-gray-400 border border-gray-200 dark:border-gray-700">200 cycles</td>
            <td class="px-4 py-3 text-sm text-right font-mono text-gray-600 dark:text-gray-400 border border-gray-200 dark:border-gray-700">4 cycles</td>
            <td class="px-4 py-3 text-sm text-right font-bold text-green-600 dark:text-green-400 border border-gray-200 dark:border-gray-700">50.0x</td>
          </tr>
          <tr class="bg-gray-50 dark:bg-gray-800/50">
            <td class="px-4 py-3 text-sm text-gray-900 dark:text-white border border-gray-200 dark:border-gray-700">Matrix Multiplication (4×4)</td>
            <td class="px-4 py-3 text-sm text-right font-mono text-gray-600 dark:text-gray-400 border border-gray-200 dark:border-gray-700">3,200 cycles</td>
            <td class="px-4 py-3 text-sm text-right font-mono text-gray-600 dark:text-gray-400 border border-gray-200 dark:border-gray-700">2,000 cycles</td>
            <td class="px-4 py-3 text-sm text-right font-bold text-green-600 dark:text-green-400 border border-gray-200 dark:border-gray-700">{metrics.performance.matrix_operation_speedup}x</td>
          </tr>
          <tr class="bg-white dark:bg-gray-900">
            <td class="px-4 py-3 text-sm text-gray-900 dark:text-white border border-gray-200 dark:border-gray-700">TNN Inference (small network)</td>
            <td class="px-4 py-3 text-sm text-right font-mono text-gray-600 dark:text-gray-400 border border-gray-200 dark:border-gray-700">8,500 cycles</td>
            <td class="px-4 py-3 text-sm text-right font-mono text-gray-600 dark:text-gray-400 border border-gray-200 dark:border-gray-700">5,700 cycles</td>
            <td class="px-4 py-3 text-sm text-right font-bold text-green-600 dark:text-green-400 border border-gray-200 dark:border-gray-700">{metrics.performance.neural_inference_speedup}x</td>
          </tr>
        </tbody>
      </table>
    </div>
    
    <h2>Hardware Metrics</h2>
    
    <h3>Area Breakdown</h3>
    
    <div class="not-prose grid md:grid-cols-2 gap-8 my-8">
      <div>
        <h4 class="text-lg font-semibold text-gray-900 dark:text-white mb-4">Component Area</h4>
        <div class="space-y-4">
          <ProgressBar 
            percentage={(metrics.area.ternary_alu_gates / metrics.area.total_overhead_gates) * 100} 
            label={`Ternary ALU (${metrics.area.ternary_alu_gates.toLocaleString()} gates)`}
            color="green" 
            size="md" 
          />
          <ProgressBar 
            percentage={(metrics.area.ternary_regfile_gates / metrics.area.total_overhead_gates) * 100} 
            label={`Ternary Register File (${metrics.area.ternary_regfile_gates.toLocaleString()} gates)`}
            color="blue" 
            size="md" 
          />
          <ProgressBar 
            percentage={(metrics.area.neural_unit_gates / metrics.area.total_overhead_gates) * 100} 
            label={`Neural Unit (${metrics.area.neural_unit_gates.toLocaleString()} gates)`}
            color="yellow" 
            size="md" 
          />
        </div>
        <div class="mt-6 p-4 rounded-lg bg-gray-100 dark:bg-gray-800">
          <p class="text-sm text-gray-600 dark:text-gray-400">
            <strong>Total MHX Overhead:</strong> {metrics.area.total_overhead_gates.toLocaleString()} gates
            <br/>
            <strong>Base Ibex Core:</strong> ~38,000 gates
            <br/>
            <strong>Total with MHX:</strong> ~{(38000 + metrics.area.total_overhead_gates).toLocaleString()} gates
          </p>
        </div>
      </div>
      
      <div>
        <h4 class="text-lg font-semibold text-gray-900 dark:text-white mb-4">Relative Overhead</h4>
        <div class="h-64 flex items-end justify-center gap-4">
          <div class="flex flex-col items-center">
            <div class="w-24 bg-blue-500 rounded-t-lg transition-all" style={`height: ${100}%`}></div>
            <p class="mt-2 text-sm font-medium text-gray-700 dark:text-gray-300">Base Ibex</p>
            <p class="text-xs text-gray-500 dark:text-gray-400">100%</p>
          </div>
          <div class="flex flex-col items-center">
            <div class="w-24 bg-green-500 rounded-t-lg transition-all" style={`height: ${metrics.area.percentage_of_base}%`}></div>
            <p class="mt-2 text-sm font-medium text-gray-700 dark:text-gray-300">MHX Extensions</p>
            <p class="text-xs text-gray-500 dark:text-gray-400">+{metrics.area.percentage_of_base}%</p>
          </div>
        </div>
      </div>
    </div>
    
    <h3>Power Consumption</h3>
    
    <div class="not-prose overflow-x-auto my-8">
      <table class="min-w-full border-collapse">
        <thead>
          <tr class="bg-gray-100 dark:bg-gray-800">
            <th class="px-4 py-3 text-left text-sm font-semibold text-gray-900 dark:text-white border border-gray-200 dark:border-gray-700">Configuration</th>
            <th class="px-4 py-3 text-right text-sm font-semibold text-gray-900 dark:text-white border border-gray-200 dark:border-gray-700">Power (mW)</th>
            <th class="px-4 py-3 text-right text-sm font-semibold text-gray-900 dark:text-white border border-gray-200 dark:border-gray-700">Frequency</th>
            <th class="px-4 py-3 text-left text-sm font-semibold text-gray-900 dark:text-white border border-gray-200 dark:border-gray-700">Notes</th>
          </tr>
        </thead>
        <tbody>
          <tr class="bg-white dark:bg-gray-900">
            <td class="px-4 py-3 text-sm text-gray-900 dark:text-white border border-gray-200 dark:border-gray-700">Base Ibex (idle)</td>
            <td class="px-4 py-3 text-sm text-right font-mono text-gray-600 dark:text-gray-400 border border-gray-200 dark:border-gray-700">2.8</td>
            <td class="px-4 py-3 text-sm text-right font-mono text-gray-600 dark:text-gray-400 border border-gray-200 dark:border-gray-700">50 MHz</td>
            <td class="px-4 py-3 text-sm text-gray-600 dark:text-gray-400 border border-gray-200 dark:border-gray-700">1.8V, no activity</td>
          </tr>
          <tr class="bg-gray-50 dark:bg-gray-800/50">
            <td class="px-4 py-3 text-sm text-gray-900 dark:text-white border border-gray-200 dark:border-gray-700">MHX with extensions (idle)</td>
            <td class="px-4 py-3 text-sm text-right font-mono text-gray-600 dark:text-gray-400 border border-gray-200 dark:border-gray-700">3.2</td>
            <td class="px-4 py-3 text-sm text-right font-mono text-gray-600 dark:text-gray-400 border border-gray-200 dark:border-gray-700">50 MHz</td>
            <td class="px-4 py-3 text-sm text-gray-600 dark:text-gray-400 border border-gray-200 dark:border-gray-700">1.8V, no activity</td>
          </tr>
          <tr class="bg-white dark:bg-gray-900">
            <td class="px-4 py-3 text-sm text-gray-900 dark:text-white border border-gray-200 dark:border-gray-700">MHX full load</td>
            <td class="px-4 py-3 text-sm text-right font-mono text-gray-600 dark:text-gray-400 border border-gray-200 dark:border-gray-700">{metrics.power.estimated_mw}</td>
            <td class="px-4 py-3 text-sm text-right font-mono text-gray-600 dark:text-gray-400 border border-gray-200 dark:border-gray-700">{metrics.power.frequency_mhz} MHz</td>
            <td class="px-4 py-3 text-sm text-gray-600 dark:text-gray-400 border border-gray-200 dark:border-gray-700">{metrics.power.voltage}V, all units active</td>
          </tr>
          <tr class="bg-gray-50 dark:bg-gray-800/50">
            <td class="px-4 py-3 text-sm text-gray-900 dark:text-white border border-gray-200 dark:border-gray-700">Software emulation (baseline)</td>
            <td class="px-4 py-3 text-sm text-right font-mono text-gray-600 dark:text-gray-400 border border-gray-200 dark:border-gray-700">16.7</td>
            <td class="px-4 py-3 text-sm text-right font-mono text-gray-600 dark:text-gray-400 border border-gray-200 dark:border-gray-700">50 MHz</td>
            <td class="px-4 py-3 text-sm text-gray-600 dark:text-gray-400 border border-gray-200 dark:border-gray-700">Emulating ternary in software</td>
          </tr>
        </tbody>
      </table>
    </div>
    
    <div class="not-prose p-6 rounded-xl bg-green-50 dark:bg-green-900/20 border border-green-200 dark:border-green-800 my-8">
      <div class="flex items-start gap-3">
        <svg class="w-6 h-6 text-green-600 dark:text-green-400 flex-shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        <div>
          <p class="font-semibold text-green-800 dark:text-green-200">Energy Efficiency</p>
          <p class="text-sm text-green-700 dark:text-green-300">
            For equivalent ternary neural network workloads, the MHX extensions provide up to 
            <strong>{metrics.power.reduction_percent}% power reduction</strong> compared to software emulation, 
            while delivering <strong>{metrics.performance.neural_inference_speedup}x faster inference</strong>.
          </p>
        </div>
      </div>
    </div>
    
    <h3>Timing Analysis</h3>
    
    <div class="not-prose overflow-x-auto my-8">
      <table class="min-w-full border-collapse">
        <thead>
          <tr class="bg-gray-100 dark:bg-gray-800">
            <th class="px-4 py-3 text-left text-sm font-semibold text-gray-900 dark:text-white border border-gray-200 dark:border-gray-700">Metric</th>
            <th class="px-4 py-3 text-right text-sm font-semibold text-gray-900 dark:text-white border border-gray-200 dark:border-gray-700">Value</th>
            <th class="px-4 py-3 text-left text-sm font-semibold text-gray-900 dark:text-white border border-gray-200 dark:border-gray-700">Notes</th>
          </tr>
        </thead>
        <tbody>
          <tr class="bg-white dark:bg-gray-900">
            <td class="px-4 py-3 text-sm text-gray-900 dark:text-white border border-gray-200 dark:border-gray-700">Target Frequency</td>
            <td class="px-4 py-3 text-sm text-right font-mono text-gray-600 dark:text-gray-400 border border-gray-200 dark:border-gray-700">{metrics.timing.target_frequency_mhz} MHz</td>
            <td class="px-4 py-3 text-sm text-gray-600 dark:text-gray-400 border border-gray-200 dark:border-gray-700">Sky130 PDK</td>
          </tr>
          <tr class="bg-gray-50 dark:bg-gray-800/50">
            <td class="px-4 py-3 text-sm text-gray-900 dark:text-white border border-gray-200 dark:border-gray-700">Critical Path</td>
            <td class="px-4 py-3 text-sm text-right font-mono text-gray-600 dark:text-gray-400 border border-gray-200 dark:border-gray-700">{metrics.timing.critical_path}</td>
            <td class="px-4 py-3 text-sm text-gray-600 dark:text-gray-400 border border-gray-200 dark:border-gray-700">Ternary ALU multiply operation</td>
          </tr>
          <tr class="bg-white dark:bg-gray-900">
            <td class="px-4 py-3 text-sm text-gray-900 dark:text-white border border-gray-200 dark:border-gray-700">Setup Slack</td>
            <td class="px-4 py-3 text-sm text-right font-mono text-gray-600 dark:text-gray-400 border border-gray-200 dark:border-gray-700">{metrics.timing.setup_slack_ns} ns</td>
            <td class="px-4 py-3 text-sm text-gray-600 dark:text-gray-400 border border-gray-200 dark:border-gray-700">Positive slack, timing met</td>
          </tr>
          <tr class="bg-gray-50 dark:bg-gray-800/50">
            <td class="px-4 py-3 text-sm text-gray-900 dark:text-white border border-gray-200 dark:border-gray-700">Hold Slack</td>
            <td class="px-4 py-3 text-sm text-right font-mono text-gray-600 dark:text-gray-400 border border-gray-200 dark:border-gray-700">{metrics.timing.hold_slack_ns} ns</td>
            <td class="px-4 py-3 text-sm text-gray-600 dark:text-gray-400 border border-gray-200 dark:border-gray-700">All paths meet hold requirements</td>
          </tr>
        </tbody>
      </table>
    </div>
    
    <h2>Memory Efficiency</h2>
    
    <p>
      Ternary encoding provides significant memory savings by representing ternary values natively 
      instead of using full 32-bit integers.
    </p>
    
    <div class="not-prose grid md:grid-cols-2 gap-6 my-8">
      <div class="p-6 rounded-xl border border-gray-200 dark:border-gray-800 bg-white dark:bg-gray-900">
        <h4 class="text-lg font-semibold text-gray-900 dark:text-white mb-4">Binary Representation</h4>
        <div class="space-y-3">
          <div class="flex justify-between">
            <span class="text-gray-600 dark:text-gray-400">Value range:</span>
            <span class="font-mono font-semibold">-1, 0, +1</span>
          </div>
          <div class="flex justify-between">
            <span class="text-gray-600 dark:text-gray-400">Bits per value:</span>
            <span class="font-mono font-semibold">32 bits</span>
          </div>
          <div class="flex justify-between">
            <span class="text-gray-600 dark:text-gray-400">16 values:</span>
            <span class="font-mono font-semibold">512 bits</span>
          </div>
        </div>
      </div>
      
      <div class="p-6 rounded-xl border-2 border-green-500 bg-green-50 dark:bg-green-900/20">
        <h4 class="text-lg font-semibold text-green-900 dark:text-green-100 mb-4">Ternary Encoding</h4>
        <div class="space-y-3">
          <div class="flex justify-between">
            <span class="text-green-700 dark:text-green-300">Value range:</span>
            <span class="font-mono font-semibold text-green-900 dark:text-green-100">-1, 0, +1</span>
          </div>
          <div class="flex justify-between">
            <span class="text-green-700 dark:text-green-300">Bits per value:</span>
            <span class="font-mono font-semibold text-green-900 dark:text-green-100">2 bits</span>
          </div>
          <div class="flex justify-between">
            <span class="text-green-700 dark:text-green-300">16 values:</span>
            <span class="font-mono font-semibold text-green-900 dark:text-green-100">32 bits</span>
          </div>
          <div class="pt-3 border-t border-green-200 dark:border-green-800">
            <p class="text-sm font-bold text-green-900 dark:text-green-100">
              Savings: {metrics.performance.memory_usage_reduction}%
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
</DocsLayout>
