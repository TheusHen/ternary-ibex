# EditorConfig helps maintain consistent coding styles across editors and IDEs
root = true

[*]
end_of_line = lf
insert_final_newline = true
charset = utf-8
trim_trailing_whitespace = true

[*.md]
# Allow trailing spaces in Markdown to preserve line breaks
trim_trailing_whitespace = false

[*.sv]
indent_style = space
indent_size = 2
trim_trailing_whitespace = true

[*.svh]
indent_style = space
indent_size = 2
trim_trailing_whitespace = true
