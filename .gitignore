# Build output
build

# Common editor/IDE config and temporary files
.project
.vscode/
.sw[a-p]
tags
*~

# ibex_tracer log file
trace_core_*.log

# Simple system output files
ibex_simple_system.log
ibex_simple_system_pcount.csv

# Python cache files
__pycache__

# This is generated by Questa tool when running DV simulations
modelsim.ini


# Verible linter
verible-*/
verible*.tar.gz

# Website Node Modules
website/node_modules/
website/dist/
website/.astro/

# Generated data files (will be created during build)
website/src/data/*.json
website/public/data/*.json
website/public/images/*
!website/public/images/.gitkeep
!website/src/data/.gitkeep
!website/public/data/.gitkeep

# Temporary files
website/.DS_Store
website/Thumbs.db

# Logs
website/npm-debug.log*
website/yarn-debug.log*
website/yarn-error.log*
website/pnpm-debug.log*

# Lock files (keep package-lock.json for reproducibility)
website/yarn.lock
website/pnpm-lock.yaml
